<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="512"
    android:viewportHeight="512">

  <!-- 1. Exterior Glowing Shield Aura -->
  <path
      android:pathData="M256,92 L416,150 C416,310 336,400 256,442 C176,400 96,310 96,150 Z"
      android:strokeWidth="16"
      android:strokeLineCap="round"
      android:strokeLineJoin="round">
    <aapt:attr name="android:strokeColor">
      <gradient
          android:startX="96"
          android:startY="92"
          android:endX="416"
          android:endY="442"
          android:type="linear">
        <item android:offset="0.0" android:color="#FF00F5FF"/>
        <item android:offset="0.4" android:color="#FF3B82F6"/>
        <item android:offset="0.8" android:color="#FF10B981"/>
        <item android:offset="1.0" android:color="#FF34D399"/>
      </gradient>
    </aapt:attr>
  </path>

  <!-- 2. Shield Body - Vibrant Cyber Sapphire & Cobalt Plate -->
  <path
      android:pathData="M256,104 L402,157 C402,298 330,380 256,420 C182,380 110,298 110,157 Z">
    <aapt:attr name="android:fillColor">
      <gradient
          android:startX="256"
          android:startY="104"
          android:endX="256"
          android:endY="420"
          android:type="linear">
        <item android:offset="0.0" android:color="#FF1E40AF"/>
        <item android:offset="0.4" android:color="#FF172554"/>
        <item android:offset="1.0" android:color="#FF0F172A"/>
      </gradient>
    </aapt:attr>
  </path>

  <!-- 3. Dynamic Bevel Right Wing (3D Lighting Dimension) -->
  <path
      android:pathData="M256,104 L402,157 C402,298 330,380 256,420 Z">
    <aapt:attr name="android:fillColor">
      <gradient
          android:startX="256"
          android:startY="104"
          android:endX="402"
          android:endY="420"
          android:type="linear">
        <item android:offset="0.0" android:color="#33FFFFFF"/>
        <item android:offset="0.5" android:color="#1A000000"/>
        <item android:offset="1.0" android:color="#4D000000"/>
      </gradient>
    </aapt:attr>
  </path>

  <!-- 4. Modern Speed Orbit Ring in Glowing Cyan -->
  <path
      android:pathData="M120,290 C140,210 240,150 350,165 C400,172 425,195 405,230 C380,270 260,335 160,320 C135,316 115,306 120,290 Z"
      android:strokeWidth="7"
      android:strokeLineCap="round">
    <aapt:attr name="android:strokeColor">
      <gradient
          android:startX="120"
          android:startY="165"
          android:endX="425"
          android:endY="320"
          android:type="linear">
        <item android:offset="0.0" android:color="#FF00F5FF"/>
        <item android:offset="0.6" android:color="#FF60A5FA"/>
        <item android:offset="1.0" android:color="#FF34D399"/>
      </gradient>
    </aapt:attr>
  </path>

  <!-- 5. Stylized Aerodynamic Modern 'Z' Main Silhouette -->
  <path
      android:pathData="M165,180 H345 L320,222 H242 L345,322 H165 L190,280 H268 L165,180 Z">
    <aapt:attr name="android:fillColor">
      <gradient
          android:startX="165"
          android:startY="180"
          android:endX="345"
          android:endY="322"
          android:type="linear">
        <item android:offset="0.0" android:color="#FFFFFFFF"/>
        <item android:offset="0.3" android:color="#FFE0F2FE"/>
        <item android:offset="0.7" android:color="#FF38BDF8"/>
        <item android:offset="1.0" android:color="#FF0284C7"/>
      </gradient>
    </aapt:attr>
  </path>

  <!-- 6. Electric Cyan Highlight on Lower Sweep of 'Z' -->
  <path
      android:pathData="M220,280 L345,280 L320,322 H165 Z">
    <aapt:attr name="android:fillColor">
      <gradient
          android:startX="165"
          android:startY="280"
          android:endX="345"
          android:endY="322"
          android:type="linear">
        <item android:offset="0.0" android:color="#FF00F5FF"/>
        <item android:offset="1.0" android:color="#FF0099FF"/>
      </gradient>
    </aapt:attr>
  </path>

  <!-- 7. Center Security Diamond Lock Emblem (Emerald & Cyan Core) -->
  <path
      android:pathData="M256,236 L276,256 L256,276 L236,256 Z">
    <aapt:attr name="android:fillColor">
      <gradient
          android:startX="236"
          android:startY="236"
          android:endX="276"
          android:endY="276"
          android:type="linear">
        <item android:offset="0.0" android:color="#FF6EE7B7"/>
        <item android:offset="0.5" android:color="#FF10B981"/>
        <item android:offset="1.0" android:color="#FF047857"/>
      </gradient>
    </aapt:attr>
  </path>

  <!-- Core Spark Dot -->
  <path
      android:pathData="M256,252 A4,4 0 1,1 256,260 A4,4 0 1,1 256,252 Z"
      android:fillColor="#FFFFFFFF" />

</vector>
