<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/apk/res-auto"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="512"
    android:viewportHeight="512">

  <!-- Outer Shield Frame - Blue Left to Gold Right -->
  <path
      android:pathData="M256,70 L100,130 C98,235 138,315 256,370"
      android:strokeWidth="16"
      android:strokeLineCap="round"
      android:strokeLineJoin="round">
    <aapt:attr name="android:strokeColor">
      <gradient
          android:startX="100"
          android:startY="70"
          android:endX="256"
          android:endY="370"
          android:type="linear">
        <item android:offset="0.0" android:color="#FF00D5FF"/>
        <item android:offset="0.5" android:color="#FF0066FF"/>
        <item android:offset="1.0" android:color="#FF0033CC"/>
      </gradient>
    </aapt:attr>
  </path>

  <path
      android:pathData="M256,70 L412,130 C414,235 374,315 256,370"
      android:strokeWidth="16"
      android:strokeLineCap="round"
      android:strokeLineJoin="round">
    <aapt:attr name="android:strokeColor">
      <gradient
          android:startX="256"
          android:startY="70"
          android:endX="412"
          android:endY="370"
          android:type="linear">
        <item android:offset="0.0" android:color="#FFFFE600"/>
        <item android:offset="0.5" android:color="#FFFFB700"/>
        <item android:offset="1.0" android:color="#FFFF8800"/>
      </gradient>
    </aapt:attr>
  </path>

  <!-- Inner White 'Z' Top Bar & Diagonal -->
  <path
      android:pathData="M150,150 h210 l-16,32 H220 L310,275 H150 l18,-32 h110 L180,150 z">
    <aapt:attr name="android:fillColor">
      <gradient
          android:startX="150"
          android:startY="150"
          android:endX="360"
          android:endY="275"
          android:type="linear">
        <item android:offset="0.0" android:color="#FFFFFFFF"/>
        <item android:offset="1.0" android:color="#FFB3D9FF"/>
      </gradient>
    </aapt:attr>
  </path>

  <!-- Gold 'Z' Bottom Sweep Accent -->
  <path
      android:pathData="M140,320 h220 c5,0 8,-4 6,-8 l-18,-34 h-160 L310,180 l-28,20 L140,320 z">
    <aapt:attr name="android:fillColor">
      <gradient
          android:startX="140"
          android:startY="180"
          android:endX="360"
          android:endY="320"
          android:type="linear">
        <item android:offset="0.0" android:color="#FFFFEA00"/>
        <item android:offset="0.6" android:color="#FFFFB700"/>
        <item android:offset="1.0" android:color="#FFFF8800"/>
      </gradient>
    </aapt:attr>
  </path>

  <!-- Bold 'VPN' Text at Bottom -->
  <!-- V -->
  <path
      android:pathData="M160,390 h18 l15,30 l15,-30 h18 l-23,42 h-20 L160,390 z"
      android:fillColor="#FFFFFF"/>

  <!-- P -->
  <path
      android:pathData="M238,390 h26 c12,0 18,6 18,14 c0,8 -6,14 -18,14 h-13 v14 h-13 V390 z M251,406 h10 c4,0 6,-2 6,-4 c0,-2 -2,-4 -6,-4 h-10 V406 z"
      android:fillColor="#FFFFFF"/>

  <!-- N -->
  <path
      android:pathData="M294,390 h13 l22,30 v-30 h13 v42 h-13 l-22,-30 v30 h-13 V390 z"
      android:fillColor="#FFFFFF"/>

</vector>
