<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="128dp"
    android:height="128dp"
    android:viewportWidth="512"
    android:viewportHeight="512">

  <!-- Background Base: Deep Cyber Navy & Electric Blue Squircle -->
  <path
      android:pathData="M112,0h288c62,0 112,50 112,112v288c0,62 -50,112 -112,112H112C50,512 0,462 0,400V112C0,50 50,0 112,0z">
    <aapt:attr name="android:fillColor">
      <gradient
          android:startX="0"
          android:startY="0"
          android:endX="512"
          android:endY="512"
          android:type="linear">
        <item android:offset="0.0" android:color="#FF1E40AF"/>
        <item android:offset="0.5" android:color="#FF0F2B66"/>
        <item android:offset="1.0" android:color="#FF071638"/>
      </gradient>
    </aapt:attr>
  </path>

  <!-- Cyan Neon Ambient Glow -->
  <path
      android:pathData="M112,0h288c62,0 112,50 112,112v288c0,62 -50,112 -112,112H112C50,512 0,462 0,400V112C0,50 50,0 112,0z">
    <aapt:attr name="android:fillColor">
      <gradient
          android:centerX="140"
          android:centerY="120"
          android:gradientRadius="280"
          android:type="radial">
        <item android:offset="0.0" android:color="#4D00F0FF"/>
        <item android:offset="0.6" android:color="#1A0088FF"/>
        <item android:offset="1.0" android:color="#00000000"/>
      </gradient>
    </aapt:attr>
  </path>

  <!-- 1. GLOWING OUTER SHIELD CONTOUR -->
  <path
      android:pathData="M256,52 L432,112 C432,288 340,396 256,448 C172,396 80,288 80,112 Z"
      android:strokeWidth="16"
      android:strokeLineCap="round"
      android:strokeLineJoin="round">
    <aapt:attr name="android:strokeColor">
      <gradient
          android:startX="80"
          android:startY="52"
          android:endX="432"
          android:endY="448"
          android:type="linear">
        <item android:offset="0.0" android:color="#FF00F5FF"/>
        <item android:offset="0.45" android:color="#FF3B82F6"/>
        <item android:offset="0.8" android:color="#FF10B981"/>
        <item android:offset="1.0" android:color="#FF34D399"/>
      </gradient>
    </aapt:attr>
  </path>

  <!-- 2. Inner Metallic Shield Core -->
  <path
      android:pathData="M256,72 L412,125 C412,275 328,375 256,420 C184,375 100,275 100,125 Z">
    <aapt:attr name="android:fillColor">
      <gradient
          android:startX="256"
          android:startY="72"
          android:endX="256"
          android:endY="420"
          android:type="linear">
        <item android:offset="0.0" android:color="#FF1E3A8A"/>
        <item android:offset="0.5" android:color="#FF172554"/>
        <item android:offset="1.0" android:color="#FF0B1329"/>
      </gradient>
    </aapt:attr>
  </path>

  <!-- 3. Dynamic Bevel Right Wing -->
  <path
      android:pathData="M256,72 L412,125 C412,275 328,375 256,420 Z">
    <aapt:attr name="android:fillColor">
      <gradient
          android:startX="256"
          android:startY="72"
          android:endX="412"
          android:endY="420"
          android:type="linear">
        <item android:offset="0.0" android:color="#33FFFFFF"/>
        <item android:offset="1.0" android:color="#4D000000"/>
      </gradient>
    </aapt:attr>
  </path>

  <!-- 4. SPEED ORBIT RING -->
  <path
      android:pathData="M90,300 C110,210 215,135 345,150 C410,158 438,185 415,225 C385,270 250,335 135,325 C105,320 85,310 90,300 Z"
      android:strokeWidth="10"
      android:strokeLineCap="round">
    <aapt:attr name="android:strokeColor">
      <gradient
          android:startX="90"
          android:startY="150"
          android:endX="438"
          android:endY="325"
          android:type="linear">
        <item android:offset="0.0" android:color="#FF00F5FF"/>
        <item android:offset="0.5" android:color="#FF60A5FA"/>
        <item android:offset="1.0" android:color="#FF34D399"/>
      </gradient>
    </aapt:attr>
  </path>

  <!-- 5. GEOMETRIC EMBLEMATIC 'Z' SYMBOL -->
  <path
      android:pathData="M165,170 H347 L318,220 H240 L347,322 H165 L194,272 H272 L165,170 Z">
    <aapt:attr name="android:fillColor">
      <gradient
          android:startX="165"
          android:startY="170"
          android:endX="347"
          android:endY="322"
          android:type="linear">
        <item android:offset="0.0" android:color="#FFFFFFFF"/>
        <item android:offset="0.4" android:color="#FFE0F2FE"/>
        <item android:offset="0.75" android:color="#FF38BDF8"/>
        <item android:offset="1.0" android:color="#FF0284C7"/>
      </gradient>
    </aapt:attr>
  </path>

  <!-- 6. Electric Cyan Highlight on Lower Wing of Z -->
  <path
      android:pathData="M225,272 L347,272 L318,322 H165 Z">
    <aapt:attr name="android:fillColor">
      <gradient
          android:startX="165"
          android:startY="272"
          android:endX="347"
          android:endY="322"
          android:type="linear">
        <item android:offset="0.0" android:color="#FF00F5FF"/>
        <item android:offset="1.0" android:color="#FF0088FF"/>
      </gradient>
    </aapt:attr>
  </path>

  <!-- 7. Center Security Diamond Lock (Emerald & Cyan Core) -->
  <path
      android:pathData="M256,234 L278,256 L256,278 L234,256 Z">
    <aapt:attr name="android:fillColor">
      <gradient
          android:startX="234"
          android:startY="234"
          android:endX="278"
          android:endY="278"
          android:type="linear">
        <item android:offset="0.0" android:color="#FF6EE7B7"/>
        <item android:offset="0.5" android:color="#FF10B981"/>
        <item android:offset="1.0" android:color="#FF047857"/>
      </gradient>
    </aapt:attr>
  </path>

  <path
      android:pathData="M256,252 A4,4 0 1,1 256,260 A4,4 0 1,1 256,252 Z"
      android:fillColor="#FFFFFFFF" />

</vector>
